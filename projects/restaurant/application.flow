# Neighborhood restaurant: tables, reservations, and a daily menu.

[type UserID [id User]]
[type TableID [id Table]]
[type DishID [id Dish]]
[type ReservationID [id Reservation]]
[type TicketID [id Ticket]]
[type RequestID [id Request]]
[type SeatCount [integer [range 1 12]]]
[type PartySize [integer [range 1 12]]]
[type Price [decimal [range 1 [pow 10 5]] [scale 2]]]
[type OrderTotal [decimal [range 1 [mul 30 [pow 10 5]]] [scale 2]]]
[type Quantity [integer [range 1 20]]]

[enum Role HOST KITCHEN]
[enum ReservationStatus REQUESTED CONFIRMED SEATED CANCELLED]
[enum Course STARTER MAIN DESSERT DRINK]
[enum OrderStatus OPEN SERVED PAID]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 2]]]
  [field name String]
  [field phone String]
  [field reservations [list Reservation] [inverse Reservation.guest]]]

[entity Table
  [field id TableID]
  [field label String]
  [field seats SeatCount]
  [field reservations [list Reservation] [inverse Reservation.table]]]

[entity Dish
  [field id DishID]
  [field name String]
  [field course Course]
  [field price Price]
  [field available Bool]]

[entity Reservation
  [field id ReservationID]
  [field guest User]
  [field table Table]
  [field partySize PartySize]
  [field startsAt DateTime]
  [field status ReservationStatus]
  [field createdAt DateTime]]

[type OrderLine [record
  [field dish Dish]
  [field name String]
  [field price Price]
  [field quantity Quantity]]]

[entity Ticket
  [field id TicketID]
  [field reservation Reservation]
  [field items [list OrderLine [min 1] [max 30]]]
  [field total OrderTotal]
  [field status OrderStatus]
  [field createdAt DateTime]]

[seed Table [rows
  [record [id 1] [label "Window 1"] [seats 2]]
  [record [id 2] [label "Garden 4"] [seats 4]]
  [record [id 3] [label "Banquet"] [seats 10]]
  [record [id 4] [label "Bar 2"] [seats 2]]
  [record [id 5] [label "Courtyard 6"] [seats 6]]]]
[seed Dish [rows
  [record [id 1] [name "Kulajda"] [course STARTER] [price 95.00] [available true]]
  [record [id 2] [name "Svíčková"] [course MAIN] [price 289.00] [available true]]
  [record [id 3] [name "Pilsner 0.5"] [course DRINK] [price 59.00] [available true]]
  [record [id 4] [name "Apple strudel"] [course DESSERT] [price 89.00] [available true]]
  [record [id 5] [name "Trout with potatoes"] [course MAIN] [price 319.00] [available true]]]]
[seed User [rows
  [record [id 1] [identitySubject "idp:u1"] [roles [list]] [name "Petra"] [phone "+420111"]]
  [record [id 2] [identitySubject "idp:u2"] [roles [list]] [name "David"] [phone "+420222"]]
  [record [id 3] [identitySubject "idp:u3"] [roles [list]] [name "Nora"] [phone "+420333"]]
  [record [id 4] [identitySubject "idp:u4"] [roles [list]] [name "Omar"] [phone "+420444"]]
  [record [id 5] [identitySubject "idp:host"] [roles [list HOST]] [name "Host stand"] [phone "+420000"]]]]
[seed Reservation [rows
  [record [id 1] [guest 1] [table 1] [partySize 2] [startsAt "2026-10-06T18:00:00Z"] [status CONFIRMED] [createdAt "2026-10-01T09:00:00Z"]]
  [record [id 2] [guest 2] [table 2] [partySize 4] [startsAt "2026-10-06T19:00:00Z"] [status REQUESTED] [createdAt "2026-10-02T11:20:00Z"]]
  [record [id 3] [guest 3] [table 5] [partySize 5] [startsAt "2026-10-07T12:00:00Z"] [status CONFIRMED] [createdAt "2026-10-03T08:15:00Z"]]
  [record [id 4] [guest 4] [table 4] [partySize 2] [startsAt "2026-10-07T20:00:00Z"] [status CANCELLED] [createdAt "2026-10-03T16:40:00Z"]]
  [record [id 5] [guest 1] [table 3] [partySize 8] [startsAt "2026-10-10T18:30:00Z"] [status SEATED] [createdAt "2026-10-04T10:00:00Z"]]]]
[seed Ticket [rows
  [record [id 1] [reservation 1]
    [items [list
      [record [dish 1] [name "Kulajda"] [price 95.00] [quantity 2]]
      [record [dish 3] [name "Pilsner 0.5"] [price 59.00] [quantity 2]]]]
    [total 308.00] [status PAID] [createdAt "2026-10-06T18:20:00Z"]]
  [record [id 2] [reservation 2]
    [items [list [record [dish 2] [name "Svíčková"] [price 289.00] [quantity 4]]]]
    [total 1156.00] [status OPEN] [createdAt "2026-10-06T19:10:00Z"]]
  [record [id 3] [reservation 3]
    [items [list
      [record [dish 5] [name "Trout with potatoes"] [price 319.00] [quantity 3]]
      [record [dish 4] [name "Apple strudel"] [price 89.00] [quantity 2]]]]
    [total 1135.00] [status SERVED] [createdAt "2026-10-07T12:25:00Z"]]
  [record [id 4] [reservation 5]
    [items [list [record [dish 2] [name "Svíčková"] [price 289.00] [quantity 8]]]]
    [total 2312.00] [status OPEN] [createdAt "2026-10-10T18:45:00Z"]]
  [record [id 5] [reservation 1]
    [items [list [record [dish 4] [name "Apple strudel"] [price 89.00] [quantity 2]]]]
    [total 178.00] [status PAID] [createdAt "2026-10-06T19:00:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "restaurant"]]
    [entity [eq User.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user anonymous]]

[permissions *
  [Dish [READ [when true]]]
  [Table [READ [when true]]]]

[permissions User
  [User [READ [when [or [eq actor target] [contains actor.roles HOST]]]]]
  [Reservation
    [READ [when [or [eq actor target.guest] [contains actor.roles HOST]]]]
    [CREATE [when [eq actor after.guest]]]
    [UPDATE [when [and
      [contains actor.roles HOST]
      [eq before.status REQUESTED]
      [eq after.status CONFIRMED]
      [only changed status]]]]]
  [Ticket
    [READ [when [or [eq actor target.reservation.guest] [contains actor.roles HOST]]]]
    [CREATE [when [contains actor.roles HOST]]]
    [UPDATE [when [contains actor.roles KITCHEN]]]]]

[type DishOutput [record [field id DishID] [field name String] [field course Course] [field price Price]]]
[type ReservationOutput [record
  [field id ReservationID] [field partySize PartySize]
  [field startsAt DateTime] [field status ReservationStatus]]]
[type TicketOutput [record
  [field id TicketID] [field total OrderTotal] [field status OrderStatus] [field createdAt DateTime]]]
[type MenuItem [record [field dishId DishID] [field quantity Quantity]]]

[query Menu
  [output [list DishOutput [max 100]]]
  [http GET "/api/menu"]
  [result [first [entities Dish] 100]]]

[query MyReservations
  [input userId UserID]
  [output [list ReservationOutput [max 20]]]
  [http GET "/api/users/{userId}/reservations"]
  [user [entity $userId]]
  [result [order [last user.reservations 20] Reservation.startsAt DESC]]]

[mutate BookTable
  [input tableId TableID]
  [input partySize PartySize]
  [input startsAt DateTime]
  [output ReservationOutput]
  [http POST "/api/reservations" [status 201]]
  [atomic]
  [table [entity $tableId]]
  [reservation [create Reservation [record
    [id [new ReservationID]] [guest request.actor] [table table]
    [partySize $partySize] [startsAt $startsAt]
    [status REQUESTED] [createdAt request.time]]]]
  [result reservation]]

[mutate ConfirmReservation
  [input reservationId ReservationID]
  [output ReservationOutput]
  [http POST "/api/reservations/{reservationId}/confirm"]
  [atomic]
  [reservation [entity $reservationId]]
  [updated [set reservation.status CONFIRMED]]
  [result reservation]]

[mutate OpenTicket
  [input reservationId ReservationID]
  [input items [list MenuItem [min 1] [max 30]]]
  [output TicketOutput]
  [http POST "/api/tickets" [status 201]]
  [atomic]
  [reservation [entity $reservationId]]
  [lines [map $items item
    [dish [entity item.dishId]]
    [snapshot [record [dish dish] [name dish.name] [price dish.price] [quantity item.quantity]]]]]
  [total [as OrderTotal [sum lines line [mul line.snapshot.price line.quantity]]]]
  [ticket [create Ticket [record
    [id [new TicketID]] [reservation reservation] [items lines.snapshot]
    [total total] [status OPEN] [createdAt request.time]]]]
  [result ticket]]
