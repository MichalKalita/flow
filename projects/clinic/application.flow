# Neighborhood clinic: patients, practitioners, slots, and visits.

[type UserID [id User]]
[type PractitionerID [id Practitioner]]
[type SlotID [id Slot]]
[type VisitID [id Visit]]
[type NoteID [id ClinicalNote]]
[type RequestID [id Request]]
[type DurationMinutes [integer [range 10 90]]]

[enum Role RECEPTION NURSE DOCTOR]
[enum Specialty GP PEDIATRICS DERMATOLOGY]
[enum SlotStatus OPEN BOOKED CANCELLED]
[enum VisitStatus SCHEDULED IN_PROGRESS COMPLETED NO_SHOW]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 2]]]
  [field name String]
  [field email String]
  [field visits [list Visit] [inverse Visit.patient]]]

[entity Practitioner
  [field id PractitionerID]
  [field name String]
  [field specialty Specialty]
  [field slots [list Slot] [inverse Slot.practitioner]]
  [field visits [list Visit] [inverse Visit.practitioner]]]

[entity Slot
  [field id SlotID]
  [field practitioner Practitioner]
  [field startsAt DateTime]
  [field duration DurationMinutes]
  [field status SlotStatus]]

[entity Visit
  [field id VisitID]
  [field patient User]
  [field practitioner Practitioner]
  [field slot Slot]
  [field status VisitStatus]
  [field createdAt DateTime]
  [field notes [list ClinicalNote] [inverse ClinicalNote.visit]]]

[entity ClinicalNote
  [field id NoteID]
  [field visit Visit]
  [field author User]
  [field body String]
  [field createdAt DateTime]]

[seed Practitioner [rows
  [record [id 1] [name "MUDr. Novák"] [specialty GP]]
  [record [id 2] [name "MUDr. Svobodová"] [specialty PEDIATRICS]]
  [record [id 3] [name "MUDr. Král"] [specialty DERMATOLOGY]]
  [record [id 4] [name "MUDr. Benešová"] [specialty GP]]
  [record [id 5] [name "MUDr. Ali"] [specialty PEDIATRICS]]]]
[seed Slot [rows
  [record [id 1] [practitioner 1] [startsAt "2026-10-06T08:00:00Z"] [duration 20] [status BOOKED]]
  [record [id 2] [practitioner 1] [startsAt "2026-10-06T08:20:00Z"] [duration 20] [status OPEN]]
  [record [id 3] [practitioner 2] [startsAt "2026-10-06T09:00:00Z"] [duration 30] [status BOOKED]]
  [record [id 4] [practitioner 3] [startsAt "2026-10-06T10:00:00Z"] [duration 20] [status OPEN]]
  [record [id 5] [practitioner 4] [startsAt "2026-10-07T08:00:00Z"] [duration 20] [status BOOKED]]]]
[seed User [rows
  [record [id 1] [identitySubject "idp:u1"] [roles [list]] [name "Petra Nováková"] [email "petra@example.test"]]
  [record [id 2] [identitySubject "idp:u2"] [roles [list]] [name "David Miller"] [email "david@example.test"]]
  [record [id 3] [identitySubject "idp:u3"] [roles [list]] [name "Nora Silva"] [email "nora@example.test"]]
  [record [id 4] [identitySubject "idp:doc"] [roles [list DOCTOR]] [name "Clinic doctor"] [email "doc@example.test"]]
  [record [id 5] [identitySubject "idp:desk"] [roles [list RECEPTION]] [name "Reception"] [email "desk@example.test"]]]]
[seed Visit [rows
  [record [id 1] [patient 1] [practitioner 1] [slot 1] [status COMPLETED] [createdAt "2026-10-01T08:00:00Z"]]
  [record [id 2] [patient 2] [practitioner 2] [slot 3] [status SCHEDULED] [createdAt "2026-10-02T09:00:00Z"]]
  [record [id 3] [patient 3] [practitioner 4] [slot 5] [status IN_PROGRESS] [createdAt "2026-10-03T08:05:00Z"]]
  [record [id 4] [patient 1] [practitioner 3] [slot 4] [status NO_SHOW] [createdAt "2026-09-20T10:00:00Z"]]
  [record [id 5] [patient 2] [practitioner 1] [slot 2] [status SCHEDULED] [createdAt "2026-10-04T11:30:00Z"]]]]
[seed ClinicalNote [rows
  [record [id 1] [visit 1] [author 4] [body "Seasonal cough, rest and tea."] [createdAt "2026-10-01T08:18:00Z"]]
  [record [id 2] [visit 2] [author 4] [body "Vaccination catch-up planned."] [createdAt "2026-10-02T09:10:00Z"]]
  [record [id 3] [visit 3] [author 4] [body "Blood pressure recheck in two weeks."] [createdAt "2026-10-03T08:25:00Z"]]
  [record [id 4] [visit 4] [author 4] [body "Did not attend; call reception."] [createdAt "2026-09-20T10:30:00Z"]]
  [record [id 5] [visit 1] [author 4] [body "Follow-up if fever returns."] [createdAt "2026-10-01T08:22:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "clinic"]]
    [entity [eq User.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user anonymous]]

[permissions *
  [Practitioner [READ [when true]]]
  [Slot [READ [when [eq target.status OPEN]]]]]

[permissions User
  [User [READ [when [or [eq actor target] [contains actor.roles RECEPTION] [contains actor.roles DOCTOR]]]]]
  [Visit
    [READ [when [or
      [eq actor target.patient]
      [contains actor.roles DOCTOR]
      [contains actor.roles RECEPTION]]]]
    [CREATE [when [or [eq actor after.patient] [contains actor.roles RECEPTION]]]]]
  [ClinicalNote
    [READ [when [or [contains actor.roles DOCTOR] [contains actor.roles NURSE]]]]
    [CREATE [when [contains actor.roles DOCTOR]]]]
  [Slot [UPDATE [when [or [eq actor after.visit.patient] [contains actor.roles RECEPTION]]]]]]

[type SlotOutput [record
  [field id SlotID] [field startsAt DateTime] [field duration DurationMinutes] [field status SlotStatus]]]
[type VisitOutput [record
  [field id VisitID] [field status VisitStatus] [field createdAt DateTime]]]
[type NoteOutput [record [field id NoteID] [field body String] [field createdAt DateTime]]]

[query OpenSlots
  [input practitionerId PractitionerID]
  [output [list SlotOutput [max 50]]]
  [http GET "/api/practitioners/{practitionerId}/slots"]
  [practitioner [entity $practitionerId]]
  [result [order [last practitioner.slots 50] Slot.startsAt ASC]]]

[query MyVisits
  [input userId UserID]
  [output [list VisitOutput [max 20]]]
  [http GET "/api/users/{userId}/visits"]
  [user [entity $userId]]
  [result [order [last user.visits 20] Visit.createdAt DESC]]]

[mutate BookVisit
  [input patientId UserID]
  [input slotId SlotID]
  [output VisitOutput]
  [http POST "/api/visits" [status 201]]
  [atomic]
  [patient [entity $patientId]]
  [slot [entity $slotId]]
  [booked [set slot.status BOOKED]]
  [visit [create Visit [record
    [id [new VisitID]] [patient patient] [practitioner slot.practitioner]
    [slot slot] [status SCHEDULED] [createdAt request.time]]]]
  [result visit]]

[mutate AddNote
  [input visitId VisitID]
  [input authorId UserID]
  [input body String]
  [output NoteOutput]
  [http POST "/api/visits/{visitId}/notes" [status 201]]
  [atomic]
  [visit [entity $visitId]]
  [author [entity $authorId]]
  [note [create ClinicalNote [record
    [id [new NoteID]] [visit visit] [author author] [body $body] [createdAt request.time]]]]
  [result note]]
