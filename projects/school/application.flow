# Small school: courses, enrollments, assignments, and grades.

[type UserID [id User]]
[type CourseID [id Course]]
[type EnrollmentID [id Enrollment]]
[type AssignmentID [id Assignment]]
[type SubmissionID [id Submission]]
[type RequestID [id Request]]
[type Capacity [integer [range 1 40]]]
[type Score [decimal [range 0 100] [scale 1]]]
[type Weight [decimal [range 0 1] [scale 2]]]

[enum Role TEACHER REGISTRAR]
[enum Term FALL SPRING]
[enum EnrollmentStatus ACTIVE DROPPED]
[enum SubmissionStatus DRAFT SUBMITTED GRADED]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 2]]]
  [field name String]
  [field email String]
  [field enrollments [list Enrollment] [inverse Enrollment.student]]
  [field taught [list Course] [inverse Course.teacher]]]

[entity Course
  [field id CourseID]
  [field code String [unique]]
  [field title String]
  [field term Term]
  [field capacity Capacity]
  [field teacher User]
  [field enrollments [list Enrollment] [inverse Enrollment.course]]
  [field assignments [list Assignment] [inverse Assignment.course]]]

[entity Enrollment
  [field id EnrollmentID]
  [field student User]
  [field course Course]
  [field status EnrollmentStatus]
  [field createdAt DateTime]]

[entity Assignment
  [field id AssignmentID]
  [field course Course]
  [field title String]
  [field dueAt DateTime]
  [field weight Weight]
  [field submissions [list Submission] [inverse Submission.assignment]]]

[entity Submission
  [field id SubmissionID]
  [field assignment Assignment]
  [field student User]
  [field body String]
  [field status SubmissionStatus]
  [field score [optional Score]]
  [field createdAt DateTime]]

[seed User [rows
  [record [id 1] [identitySubject "idp:s1"] [roles [list]] [name "Eva Student"] [email "eva@school.test"]]
  [record [id 2] [identitySubject "idp:s2"] [roles [list]] [name "Jan Student"] [email "jan@school.test"]]
  [record [id 3] [identitySubject "idp:s3"] [roles [list]] [name "Lea Student"] [email "lea@school.test"]]
  [record [id 4] [identitySubject "idp:t1"] [roles [list TEACHER]] [name "Prof. Holub"] [email "holub@school.test"]]
  [record [id 5] [identitySubject "idp:r1"] [roles [list REGISTRAR]] [name "Registrar"] [email "office@school.test"]]]]
[seed Course [rows
  [record [id 1] [code "CS101"] [title "Intro to Computing"] [term FALL] [capacity 30] [teacher 4]]
  [record [id 2] [code "LIT200"] [title "Czech Literature"] [term FALL] [capacity 20] [teacher 4]]
  [record [id 3] [code "HIS110"] [title "Central Europe 1918"] [term FALL] [capacity 25] [teacher 4]]
  [record [id 4] [code "MATH120"] [title "Discrete Math"] [term SPRING] [capacity 28] [teacher 4]]
  [record [id 5] [code "ART150"] [title "Studio Drawing"] [term SPRING] [capacity 16] [teacher 4]]]]
[seed Enrollment [rows
  [record [id 1] [student 1] [course 1] [status ACTIVE] [createdAt "2026-09-01T08:00:00Z"]]
  [record [id 2] [student 1] [course 2] [status ACTIVE] [createdAt "2026-09-01T08:05:00Z"]]
  [record [id 3] [student 2] [course 1] [status ACTIVE] [createdAt "2026-09-01T09:00:00Z"]]
  [record [id 4] [student 3] [course 3] [status DROPPED] [createdAt "2026-09-02T10:00:00Z"]]
  [record [id 5] [student 2] [course 4] [status ACTIVE] [createdAt "2026-09-03T11:00:00Z"]]]]
[seed Assignment [rows
  [record [id 1] [course 1] [title "Hello, machine"] [dueAt "2026-10-10T22:00:00Z"] [weight 0.20]]
  [record [id 2] [course 1] [title "Types on paper"] [dueAt "2026-10-24T22:00:00Z"] [weight 0.30]]
  [record [id 3] [course 2] [title "Němcová close reading"] [dueAt "2026-10-12T22:00:00Z"] [weight 0.25]]
  [record [id 4] [course 3] [title "Map of 1918"] [dueAt "2026-10-15T22:00:00Z"] [weight 0.20]]
  [record [id 5] [course 5] [title "Still life 1"] [dueAt "2026-10-08T22:00:00Z"] [weight 0.15]]]]
[seed Submission [rows
  [record [id 1] [assignment 1] [student 1] [body "Printed hello."] [status GRADED] [score 92.0] [createdAt "2026-10-09T20:00:00Z"]]
  [record [id 2] [assignment 1] [student 2] [body "Late but complete."] [status SUBMITTED] [createdAt "2026-10-10T21:50:00Z"]]
  [record [id 3] [assignment 3] [student 1] [body "Grandmother and weather."] [status GRADED] [score 88.5] [createdAt "2026-10-11T19:00:00Z"]]
  [record [id 4] [assignment 4] [student 3] [body "Draft borders."] [status DRAFT] [createdAt "2026-10-05T12:00:00Z"]]
  [record [id 5] [assignment 2] [student 1] [body "Nominal vs structural."] [status SUBMITTED] [createdAt "2026-10-20T18:30:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "school"]]
    [entity [eq User.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user anonymous]]

[permissions *
  [Course [READ [when true]]]]

[permissions User
  [Enrollment
    [READ [when [or [eq actor target.student] [eq actor target.course.teacher] [contains actor.roles REGISTRAR]]]]
    [CREATE [when [or [eq actor after.student] [contains actor.roles REGISTRAR]]]]]
  [Assignment
    [READ [when [or
      [eq actor target.course.teacher]
      [any target.course.enrollments e [and [eq e.student actor] [eq e.status ACTIVE]]]]]]
    [CREATE [when [eq actor after.course.teacher]]]]
  [Submission
    [READ [when [or [eq actor target.student] [eq actor target.assignment.course.teacher]]]]
    [CREATE [when [and
      [eq actor after.student]
      [any after.assignment.course.enrollments e [and
        [eq e.student actor]
        [eq e.status ACTIVE]]]]]]
    [UPDATE [when [eq actor after.assignment.course.teacher]]]]]

[type CourseOutput [record [field id CourseID] [field code String] [field title String] [field term Term]]]
[type EnrollmentOutput [record [field id EnrollmentID] [field status EnrollmentStatus]]]
[type AssignmentOutput [record [field id AssignmentID] [field title String] [field dueAt DateTime]]]
[type SubmissionOutput [record
  [field id SubmissionID] [field status SubmissionStatus] [field score [optional Score]]]]

[query Catalog
  [output [list CourseOutput [max 50]]]
  [http GET "/api/courses"]
  [result [first [entities Course] 50]]]

[query CourseAssignments
  [input courseId CourseID]
  [output [list AssignmentOutput [max 30]]]
  [http GET "/api/courses/{courseId}/assignments"]
  [course [entity $courseId]]
  [result [order [last course.assignments 30] Assignment.dueAt ASC]]]

[mutate Enroll
  [input studentId UserID]
  [input courseId CourseID]
  [output EnrollmentOutput]
  [http POST "/api/enrollments" [status 201]]
  [atomic]
  [student [entity $studentId]]
  [course [entity $courseId]]
  [enrollment [create Enrollment [record
    [id [new EnrollmentID]] [student student] [course course]
    [status ACTIVE] [createdAt request.time]]]]
  [result enrollment]]

[mutate SubmitWork
  [input assignmentId AssignmentID]
  [input body String]
  [output SubmissionOutput]
  [http POST "/api/submissions" [status 201]]
  [atomic]
  [assignment [entity $assignmentId]]
  [submission [create Submission [record
    [id [new SubmissionID]] [student request.actor] [assignment assignment]
    [body $body] [status SUBMITTED] [createdAt request.time]]]]
  [result submission]]

[mutate GradeSubmission
  [input submissionId SubmissionID]
  [input score Score]
  [output SubmissionOutput]
  [http POST "/api/submissions/{submissionId}/grade"]
  [atomic]
  [submission [entity $submissionId]]
  [scored [set submission.score $score]]
  [graded [set submission.status GRADED]]
  [result submission]]
