# Job board: companies, listings, applications, and messages.

[type UserID [id User]]
[type CompanyID [id Company]]
[type ListingID [id Listing]]
[type ApplicationID [id Application]]
[type MessageID [id Message]]
[type RequestID [id Request]]
[type Salary [decimal [range 1000 [pow 10 7]] [scale 0]]]

[enum Role RECRUITER]
[enum Workplace REMOTE HYBRID ONSITE]
[enum ListingStatus OPEN CLOSED]
[enum ApplicationStatus SUBMITTED REVIEWING OFFER REJECTED]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 1]]]
  [field name String]
  [field email String]
  [field headline String]
  [field company [optional Company]]
  [field applications [list Application] [inverse Application.candidate]]]

[entity Company
  [field id CompanyID]
  [field name String]
  [field website String]
  [field listings [list Listing] [inverse Listing.company]]]

[entity Listing
  [field id ListingID]
  [field company Company]
  [field title String]
  [field workplace Workplace]
  [field salaryMin Salary]
  [field salaryMax Salary]
  [field status ListingStatus]
  [field postedAt DateTime]
  [field applications [list Application] [inverse Application.listing]]]

[entity Application
  [field id ApplicationID]
  [field listing Listing]
  [field candidate User]
  [field coverLetter String]
  [field status ApplicationStatus]
  [field createdAt DateTime]
  [field messages [list Message] [inverse Message.application]]]

[entity Message
  [field id MessageID]
  [field application Application]
  [field author User]
  [field body String]
  [field createdAt DateTime]]

[seed Company [rows
  [record [id 1] [name "River Labs"] [website "https://river.example"]]
  [record [id 2] [name "Oak Press"] [website "https://oak.example"]]
  [record [id 3] [name "North Clinic"] [website "https://north.example"]]
  [record [id 4] [name "Tram Design"] [website "https://tram.example"]]
  [record [id 5] [name "Harbor Books"] [website "https://harbor.example"]]]]
[seed Listing [rows
  [record [id 1] [company 1] [title "Backend engineer"] [workplace REMOTE]
    [salaryMin 90000] [salaryMax 130000] [status OPEN] [postedAt "2026-09-01T00:00:00Z"]]
  [record [id 2] [company 2] [title "Editor"] [workplace HYBRID]
    [salaryMin 45000] [salaryMax 65000] [status OPEN] [postedAt "2026-09-15T00:00:00Z"]]
  [record [id 3] [company 3] [title "Clinic receptionist"] [workplace ONSITE]
    [salaryMin 32000] [salaryMax 40000] [status OPEN] [postedAt "2026-09-20T00:00:00Z"]]
  [record [id 4] [company 4] [title "Product designer"] [workplace HYBRID]
    [salaryMin 70000] [salaryMax 95000] [status OPEN] [postedAt "2026-09-22T00:00:00Z"]]
  [record [id 5] [company 5] [title "Bookseller"] [workplace ONSITE]
    [salaryMin 28000] [salaryMax 36000] [status CLOSED] [postedAt "2026-08-01T00:00:00Z"]]]]
[seed User [rows
  [record [id 1] [identitySubject "idp:u1"] [roles [list]] [name "Nora Silva"] [email "nora@example.test"] [headline "Rust and SQLite"]]
  [record [id 2] [identitySubject "idp:u2"] [roles [list]] [name "Petra Nováková"] [email "petra@example.test"] [headline "Editorial intern"]]
  [record [id 3] [identitySubject "idp:u3"] [roles [list]] [name "David Miller"] [email "david@example.test"] [headline "Front desk and people"]]
  [record [id 4] [identitySubject "idp:u4"] [roles [list]] [name "Omar Haddad"] [email "omar@example.test"] [headline "Interface design"]]
  [record [id 5] [identitySubject "idp:hr"] [roles [list RECRUITER]] [name "River HR"] [email "hr@river.example"] [headline ""] [company 1]]]]
[seed Application [rows
  [record [id 1] [listing 1] [candidate 1] [coverLetter "I ship SQLite services."] [status REVIEWING] [createdAt "2026-09-10T09:00:00Z"]]
  [record [id 2] [listing 2] [candidate 2] [coverLetter "I mark up manuscripts."] [status SUBMITTED] [createdAt "2026-09-16T11:00:00Z"]]
  [record [id 3] [listing 3] [candidate 3] [coverLetter "Calm at the desk."] [status OFFER] [createdAt "2026-09-21T08:30:00Z"]]
  [record [id 4] [listing 4] [candidate 4] [coverLetter "Screens that stay quiet."] [status REJECTED] [createdAt "2026-09-23T14:00:00Z"]]
  [record [id 5] [listing 1] [candidate 4] [coverLetter "Also interested in APIs."] [status SUBMITTED] [createdAt "2026-09-25T10:00:00Z"]]]]
[seed Message [rows
  [record [id 1] [application 1] [author 5] [body "Can you start in November?"] [createdAt "2026-09-12T10:00:00Z"]]
  [record [id 2] [application 1] [author 1] [body "Yes, after the 3rd."] [createdAt "2026-09-12T15:00:00Z"]]
  [record [id 3] [application 3] [author 5] [body "Offer letter attached in spirit."] [createdAt "2026-09-24T09:00:00Z"]]
  [record [id 4] [application 4] [author 5] [body "We went with another portfolio."] [createdAt "2026-09-26T16:00:00Z"]]
  [record [id 5] [application 2] [author 2] [body "Sample pages are ready."] [createdAt "2026-09-17T08:00:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "jobs"]]
    [entity [eq User.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user anonymous]]

[permissions *
  [Company [READ [when true]]]
  [Listing [READ [when [eq target.status OPEN]]]]]

[permissions User
  [User [READ [when [eq actor target]]]]
  [Application
    [READ [when [or
      [eq actor target.candidate]
      [and [contains actor.roles RECRUITER] [eq actor.company target.listing.company]]]]]
    [CREATE [when [and
      [eq actor after.candidate]
      [eq after.listing.status OPEN]]]]
    [UPDATE [when [and
      [contains actor.roles RECRUITER]
      [eq actor.company after.listing.company]]]]]
  [Message
    [READ [when [can READ target.application]]]
    [CREATE [when [and [eq actor after.author] [can READ after.application]]]]]]

[type ListingOutput [record
  [field id ListingID] [field title String] [field workplace Workplace]
  [field salaryMin Salary] [field salaryMax Salary]]]
[type ApplicationOutput [record
  [field id ApplicationID] [field status ApplicationStatus] [field createdAt DateTime]]]
[type MessageOutput [record [field id MessageID] [field body String] [field createdAt DateTime]]]

[query Openings
  [output [list ListingOutput [max 100]]]
  [http GET "/api/listings"]
  [result [first [entities Listing] 100]]]

[query Listing
  [input listingId ListingID]
  [output ListingOutput]
  [http GET "/api/listings/{listingId}"]
  [result [entity $listingId]]]

[query MyApplications
  [input userId UserID]
  [output [list ApplicationOutput [max 50]]]
  [http GET "/api/users/{userId}/applications"]
  [user [entity $userId]]
  [result [order [last user.applications 50] Application.createdAt DESC]]]

[mutate Apply
  [input listingId ListingID]
  [input coverLetter String]
  [output ApplicationOutput]
  [http POST "/api/applications" [status 201]]
  [atomic]
  [listing [entity $listingId]]
  [application [create Application [record
    [id [new ApplicationID]] [candidate request.actor] [listing listing]
    [coverLetter $coverLetter] [status SUBMITTED] [createdAt request.time]]]]
  [result application]]

[mutate MessageCandidate
  [input applicationId ApplicationID]
  [input body String]
  [output MessageOutput]
  [http POST "/api/applications/{applicationId}/messages" [status 201]]
  [atomic]
  [application [entity $applicationId]]
  [message [create Message [record
    [id [new MessageID]] [application application] [author request.actor]
    [body $body] [createdAt request.time]]]]
  [result message]]
