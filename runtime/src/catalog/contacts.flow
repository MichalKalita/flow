# Contacts: an isolated application with a permission-checked owner.
[type UserID [id User]]
[type ContactID [id Contact]]
[type ContactName [string [minBytes 1] [maxBytes 200]]]
[type ContactEmail [string [maxBytes 254]]]
[type ContactPhone [string [maxBytes 80]]]
[type ContactNotes [string [maxBytes 4096]]]
[type Version [integer [range 1 9007199254740991]]]
[entity User [field id UserID] [field subject String [unique]]]
[entity Contact
  [field id ContactID] [field owner User] [field name ContactName]
  [field email ContactEmail] [field phone ContactPhone] [field notes ContactNotes]
  [field version Version]]
[type ContactOutput [record [field id ContactID] [field name ContactName]
  [field email ContactEmail] [field phone ContactPhone] [field notes ContactNotes]
  [field version Version]]]
[seed User [rows [record [id 1] [subject "owner"]]]]
[auth [user User [jwt [issuer "flow-catalog:PROJECT_NAME"] [audience "PROJECT_NAME"]]
  [entity [eq User.subject claims.sub]]]]
[transport HTTP [auth user]]
[permissions User
  [User [READ [when [eq actor target]]]]
  [Contact
    [READ [when [eq actor target.owner]]]
    [CREATE [when [eq actor after.owner]]]
    [UPDATE [when [and [eq actor before.owner] [eq actor after.owner]
      [eq after.version [add before.version 1]]]]]
    [DELETE [when [eq actor target.owner]]]]]
[query Contacts [input after [optional ContactID]]
  [output [list ContactOutput [max 50]]] [http GET "/api/contacts"]
  [result [page Contact $after 50]]]
[mutate CreateContact
  [input name ContactName] [input email ContactEmail [default ""]]
  [input phone ContactPhone [default ""]] [input notes ContactNotes [default ""]]
  [output ContactOutput] [http POST "/api/contacts" [status 201]] [atomic]
  [contact [create Contact [record [id [new ContactID]] [owner request.actor]
    [name $name] [email $email] [phone $phone] [notes $notes] [version 1]]]]
  [result contact]]
[mutate UpdateContact
  [input contactId ContactID] [input version Version]
  [input name ContactName] [input email ContactEmail]
  [input phone ContactPhone] [input notes ContactNotes]
  [output ContactOutput] [http PUT "/api/contacts/{contactId}"] [atomic]
  [contact [expectVersion [entity $contactId] $version]]
  [named [set contact.name $name]] [emailed [set contact.email $email]]
  [phoned [set contact.phone $phone]] [noted [set contact.notes $notes]]
  [versioned [set contact.version [add $version 1]]]
  [result contact]]
[mutate DeleteContact
  [input contactId ContactID] [input version Version]
  [output Bool] [http DELETE "/api/contacts/{contactId}"] [atomic]
  [contact [expectVersion [entity $contactId] $version]]
  [removed [delete contact]] [result true]]
