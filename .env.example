# Copy this file to .env. It is sourced as trusted POSIX shell configuration.
# Generate the admin token with: openssl rand -hex 32
FLOW_ADMIN_TOKEN=''
FLOW_ADMIN_BIND='127.0.0.1:9090'
FLOW_HTTP_BIND='0.0.0.0:80'
FLOW_MQTT_BIND='127.0.0.1:1883'

# Development credentials for hosted projects under projects/. Replace them and
# the corresponding seeded credential hashes before using these apps in production.
FLOW_JWT_SECRET='development-key-32-bytes-minimum-123456'
FLOW_AUTOMATION_KEY='automation-key-long-enough-123456789'

# Relative paths are resolved from the repository root.
FLOW_APPLICATION='projects'
FLOW_DATABASE='data/projects'
FLOW_OBSERVABILITY_DIR='data/observability'

# Optional capacity. Defaults follow CPU count and host RAM (minimum 16
# in-flight HTTP requests, matching a 1 CPU / 2 GiB host).
# FLOW_TOKIO_WORKERS=2
# FLOW_TOKIO_BLOCKING=2
# FLOW_HTTP_ADMISSION=16
