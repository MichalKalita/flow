# Copy this file to .env. It is sourced as trusted POSIX shell configuration.
# Generate the admin token with: openssl rand -hex 32
FLOW_ADMIN_TOKEN=''
FLOW_ADMIN_BIND='127.0.0.1:9090'
FLOW_HTTP_BIND='127.0.0.1:8080'
FLOW_MQTT_BIND='127.0.0.1:1883'

# Development credentials for runtime/application.flow. Replace them and the
# corresponding seeded credential hashes before using this example in production.
FLOW_JWT_SECRET='development-key-32-bytes-minimum-123456'
FLOW_AUTOMATION_KEY='automation-key-long-enough-123456789'

# Relative paths are resolved from the repository root.
FLOW_APPLICATION='runtime/application.flow'
FLOW_DATABASE='data/flow-numeric.sqlite'
FLOW_OBSERVABILITY_DIR='data/observability'
