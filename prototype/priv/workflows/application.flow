# Celá aplikace: kontrakty, zdroje a scénáře v jediném souboru.
TYPE UserID = String WHERE length(value) > 0
TYPE Quantity = Int WHERE value BETWEEN 1 AND 100
TYPE Stock = Int WHERE value >= 0
TYPE Price = Int WHERE value >= 0
TYPE CartItem = {product_id: String, quantity: Quantity}
TYPE Cart = List<CartItem> WHERE length(value) BETWEEN 1 AND 50
TYPE PaymentMethod = String WHERE value IN ["card", "bank"]
TYPE Product = {id: String, name: String, price_cents: Price, stock: Stock}
TYPE User = {id: String, name: String, email: String, country: String}
TYPE OrderItem = {id: String, name: String, price_cents: Price, quantity: Int}
TYPE Order = {id: String, user_id: String, request_id: String, created_at: String,
    items: List<OrderItem>, total_cents: Int, payment_method: PaymentMethod,
    payment_url: String, status: String}
TABLE Products = Product
TABLE Users = User
TABLE Orders = Order

SEED Products WITH [
    {id: "p1", name: "Studio sluchátka", price_cents: 249000, stock: 12},
    {id: "p2", name: "Mechanická klávesnice", price_cents: 329000, stock: 5},
    {id: "p3", name: "USB-C rozbočovač", price_cents: 129000, stock: 2},
    {id: "p4", name: "Webkamera", price_cents: 189000, stock: 0}
]
SEED Users WITH [
    {id: "u1", name: "Petra Nováková", email: "petra@example.test", country: "CZ"},
    {id: "u2", name: "David Miller", email: "david@example.test", country: "US"},
    {id: "u3", name: "Nora Silva", email: "nora@example.test", country: "BR"}
]

TYPE DeviceID = String WHERE length(value) BETWEEN 1 AND 64
TYPE Battery = Int WHERE value BETWEEN 0 AND 100
TYPE Latitude = Number WHERE value BETWEEN -90 AND 90
TYPE Longitude = Number WHERE value BETWEEN -180 AND 180
MQTT DeviceStatus
    TOPIC "devices/{device_id}/status"
    PARAM device_id DeviceID
    PAYLOAD {online: Bool, battery: Battery}
    HISTORY 24 HOURS
MQTT DevicePosition
    TOPIC "devices/{device_id}/position"
    PARAM device_id DeviceID
    PAYLOAD {latitude: Latitude, longitude: Longitude}
    HISTORY 5 MINUTES

TABLE DeviceAlerts = {id: String, device_id: DeviceID, kind: String, created_at: String}
ON MQTT DeviceStatus
    WHEN :message.battery < 20
        TRANSACTION
            INSERT DeviceAlerts WITH {id: uuid("alert"), device_id: :device_id, kind: "low_battery", created_at: request.time}
            COMMIT
    RETURN {accepted: true}

HTTP GET /api/device-alerts/:device_id
INPUT device_id DeviceID
alerts = FROM DeviceAlerts AS a WHERE a.device_id = :device_id
RETURN {alerts: alerts}

HTTP GET /api/devices/:device_id
INPUT device_id DeviceID
status = LAST FROM DeviceStatus(:device_id) AS s
positions = FROM DevicePosition(:device_id) AS p
    WHERE p.received_at >= ago(5, "minutes")
    ORDER BY p.received_at ASC
RETURN {device_id: :device_id, status: status, positions: positions}

HTTP POST /api/orders
INPUT user_id UserID
INPUT items Cart
INPUT payment_method PaymentMethod
INPUT email_failure Bool = false
TRANSACTION
    user = ONE FROM Users AS u WHERE u.id = :user_id
    REQUIRE user IS PRESENT ELSE 404 user_not_found "Uživatel neexistuje."
    cart = group_sum(:items, "product_id", "quantity")
    snapshots: List<OrderItem> = FOR EACH item IN cart
        product = ONE FROM Products AS p WHERE p.id = item.product_id
        REQUIRE product IS PRESENT ELSE 404 product_not_found "Produkt neexistuje."
        RETURN {id: product.id, name: product.name, price_cents: product.price_cents, quantity: item.quantity}
    total: Int = SUM item IN snapshots OF item.price_cents * item.quantity
    order: Order = INSERT Orders WITH {
        id: uuid("ord"), user_id: user.id, request_id: request.id, created_at: request.time,
        items: snapshots, total_cents: total, payment_method: :payment_method,
        payment_url: "", status: "awaiting_payment"
    }
    FOR EACH item IN snapshots
        product = ONE FROM Products AS p WHERE p.id = item.id
        REQUIRE product IS PRESENT ELSE 404 product_not_found "Produkt neexistuje."
        REQUIRE product.stock >= item.quantity ELSE 409 insufficient_stock "Nedostatek kusů na skladě."
        UPDATE Products AS p WHERE p.id = item.id SET {stock: p.stock - item.quantity}
    payment = CALL Payment.create_url WITH {
        order_id: order.id, amount_cents: order.total_cents, currency: "CZK",
        country: user.country, method: :payment_method
    }
    UPDATE Orders AS o WHERE o.id = order.id SET {payment_url: payment.url}
    QUEUE Email.send_confirmation WITH {
        order_id: order.id, to: user.email, subject: concat(["Objednávka ", order.id]),
        payment_url: payment.url, total_cents: order.total_cents, items: snapshots,
        simulate_failure: :email_failure
    } POLICY 3 ATTEMPTS DELAY 1000 ms RETAIN
    COMMIT
RESPONSE 201 WITH {order: merge(order, {currency: "CZK"}), payment: payment, email: {state: "queued"}}

HTTP GET /api/orders/:order_id
INPUT order_id String
order = ONE FROM Orders AS o WHERE o.id = :order_id
REQUIRE order IS PRESENT ELSE 404 order_not_found "Objednávka neexistuje."
RETURN order

# Soubory i aplikační záznamy se potvrdí společně.
TYPE ProductPhoto = Image WHERE value.byte_size <= 10485760 AND value.width <= 8000 AND value.height <= 8000
TYPE PhotoSize = Int WHERE value BETWEEN 1 AND 4096
TABLE Photos = {id: String, product_id: String, file_id: String, url: String, width: Int, height: Int}
HTTP POST /api/products/:product_id/photo
INPUT product_id String
INPUT photo ProductPhoto
INPUT width PhotoSize = 800
INPUT height PhotoSize = 600
TRANSACTION
    product = ONE FROM Products AS p WHERE p.id = :product_id
    REQUIRE product IS PRESENT ELSE 404 product_not_found "Produkt neexistuje."
    resized: ProductPhoto = CALL Image.resize WITH {image: :photo, width: :width, height: :height}
    stored = CALL Files.put WITH {file: resized}
    saved = INSERT Photos WITH {id: uuid("photo"), product_id: :product_id, file_id: stored.id, url: stored.url, width: resized.width, height: resized.height}
    COMMIT
RESPONSE 201 WITH {photo: saved, file: stored}

HTTP GET /api/products/:product_id/photos
INPUT product_id String
photos = FROM Photos AS p WHERE p.product_id = :product_id
RETURN {photos: photos}

TABLE DeviceAccess = {id: String, user_id: UserID, token: String, device_id: DeviceID}
SEED DeviceAccess WITH [
    {id: "petra-mower1", user_id: "u1", token: "demo-petra", device_id: "mower1"},
    {id: "david-mower2", user_id: "u2", token: "demo-david", device_id: "mower2"}
]

WEBSOCKET /ws
    INPUT token String
    AUTHORIZE EXISTS access IN DeviceAccess WHERE access.token = :token AND EXISTS user IN Users WHERE user.id = access.user_id
    SOURCE DeviceStatus WHERE EXISTS access IN DeviceAccess WHERE access.token = :token AND access.device_id = :device_id
    SOURCE DevicePosition WHERE EXISTS access IN DeviceAccess WHERE access.token = :token AND access.device_id = :device_id


TYPE MowerAction = String WHERE value IN ["start", "stop"]
MQTT DeviceCommand
    TOPIC "devices/{device_id}/command"
    PARAM device_id DeviceID
    PAYLOAD {command_id: String, action: MowerAction}
    HISTORY 24 HOURS

HTTP POST /api/devices/:device_id/commands
INPUT device_id DeviceID
INPUT action MowerAction
INPUT token String
REQUIRE EXISTS access IN DeviceAccess WHERE access.token = :token AND access.device_id = :device_id AND EXISTS user IN Users WHERE user.id = access.user_id ELSE 403 forbidden "Přístup k zařízení je zamítnut."
TRANSACTION
    outgoing = PUBLISH DeviceCommand(:device_id) WITH {command_id: uuid("command"), action: :action}
    COMMIT
RESPONSE 202 WITH outgoing
