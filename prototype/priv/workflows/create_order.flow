# OrderLab DSL v0: registered, typed operations; no user-defined functions.
REST POST /api/orders
INPUT user_id User.ID
INPUT items List<OrderItem>
INPUT payment_method PaymentMethod
INPUT email_failure Bool = false

TRANSACTION
    SNAPSHOT Products AS order
    DECREASE Inventory FROM order.items
    CALL Payment.create_url WITH order AS payment
    QUEUE Email.send_confirmation WITH order, payment
    COMMIT

RETURN order, payment
