# City rideshare: riders, drivers, vehicles, and live trip positions.

[type UserID [id User]]
[type DriverID [id Driver]]
[type VehicleID [id Vehicle]]
[type TripID [id Trip]]
[type RequestID [id Request]]
[type Latitude [decimal [range -90 90] [scale 6]]]
[type Longitude [decimal [range -180 180] [scale 6]]]
[type Fare [decimal [range 1 [pow 10 5]] [scale 2]]]
[type Rating [decimal [range 1 5] [scale 1]]]

[enum Role DISPATCH]
[enum VehicleKind CAR BIKE]
[enum TripStatus REQUESTED MATCHED EN_ROUTE COMPLETED CANCELLED]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 1]]]
  [field name String]
  [field trips [list Trip] [inverse Trip.rider]]]

[entity Driver
  [field id DriverID]
  [field identitySubject String [unique]]
  [field name String]
  [field rating Rating]
  [field vehicle Vehicle]
  [field trips [list Trip] [inverse Trip.driver]]
  [field positions [list DriverPosition] [stream DriverPosition.driver]]]

[entity Vehicle
  [field id VehicleID]
  [field plate String [unique]]
  [field kind VehicleKind]]

[entity Trip
  [field id TripID]
  [field rider User]
  [field driver [optional Driver]]
  [field pickupLat Latitude]
  [field pickupLng Longitude]
  [field dropoffLat Latitude]
  [field dropoffLng Longitude]
  [field fare Fare]
  [field status TripStatus]
  [field createdAt DateTime]]

[stream DriverPosition
  [mqtt "drivers/{driver}/position"]
  [history [duration "10m"] [maxMessages 2000]]
  [field driver Driver]
  [field receivedAt DateTime [receivedAt]]
  [field latitude Latitude]
  [field longitude Longitude]]

[seed Vehicle [rows
  [record [id "v1"] [plate "1A2 3456"] [kind CAR]]
  [record [id "v2"] [plate "E-BIKE-09"] [kind BIKE]]
  [record [id "v3"] [plate "2B3 1111"] [kind CAR]]
  [record [id "v4"] [plate "E-BIKE-12"] [kind BIKE]]
  [record [id "v5"] [plate "3C4 7788"] [kind CAR]]]]
[seed Driver [rows
  [record [id "d1"] [identitySubject "idp:d1"] [name "Jana"] [rating 4.8] [vehicle "v1"]]
  [record [id "d2"] [identitySubject "idp:d2"] [name "Omar"] [rating 4.6] [vehicle "v2"]]
  [record [id "d3"] [identitySubject "idp:d3"] [name "Iva"] [rating 4.9] [vehicle "v3"]]
  [record [id "d4"] [identitySubject "idp:d4"] [name "Tomas"] [rating 4.4] [vehicle "v4"]]
  [record [id "d5"] [identitySubject "idp:d5"] [name "Lea"] [rating 4.7] [vehicle "v5"]]]]
[seed User [rows
  [record [id "u1"] [identitySubject "idp:u1"] [roles [list]] [name "Petra"]]
  [record [id "u2"] [identitySubject "idp:u2"] [roles [list]] [name "David"]]
  [record [id "u3"] [identitySubject "idp:u3"] [roles [list]] [name "Nora"]]
  [record [id "u4"] [identitySubject "idp:u4"] [roles [list]] [name "Martin"]]
  [record [id "ops"] [identitySubject "idp:ops"] [roles [list DISPATCH]] [name "Dispatch"]]]]
[seed Trip [rows
  [record [id "t1"] [rider "u1"] [driver "d1"] [pickupLat 50.087000] [pickupLng 14.421000]
    [dropoffLat 50.075500] [dropoffLng 14.437800] [fare 189.00] [status COMPLETED] [createdAt "2026-10-01T08:10:00Z"]]
  [record [id "t2"] [rider "u2"] [driver "d2"] [pickupLat 50.101200] [pickupLng 14.395000]
    [dropoffLat 50.070100] [dropoffLng 14.401200] [fare 95.00] [status EN_ROUTE] [createdAt "2026-10-05T07:40:00Z"]]
  [record [id "t3"] [rider "u3"] [pickupLat 50.064000] [pickupLng 14.430000]
    [dropoffLat 50.090000] [dropoffLng 14.450000] [fare 220.00] [status REQUESTED] [createdAt "2026-10-05T08:01:00Z"]]
  [record [id "t4"] [rider "u4"] [driver "d3"] [pickupLat 50.050000] [pickupLng 14.410000]
    [dropoffLat 50.080000] [dropoffLng 14.460000] [fare 310.00] [status MATCHED] [createdAt "2026-10-05T08:15:00Z"]]
  [record [id "t5"] [rider "u1"] [driver "d5"] [pickupLat 50.088800] [pickupLng 14.400100]
    [dropoffLat 50.100000] [dropoffLng 14.390000] [fare 140.00] [status CANCELLED] [createdAt "2026-10-04T22:00:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "rideshare"]]
    [entity [eq User.identitySubject claims.sub]]]
  [driver Driver
    [jwt [issuer "https://identity.example.com"] [audience "rideshare"]]
    [entity [eq Driver.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user driver anonymous]]
[transport MQTT [auth driver]]
[transport WebSocket [auth user driver]]

[permissions User
  [Trip
    [READ [when [eq actor target.rider]]]
    [CREATE [when [eq actor after.rider]]]]]
[permissions Driver
  [Trip
    [READ [when [eq actor target.driver]]]
    [UPDATE [when [eq actor after.driver]]]]
  [DriverPosition [CREATE [when [eq actor after.driver]]]]]
[permissions User
  [DriverPosition [READ [when [eq actor target.driver.trips.rider]]]]]

[type TripOutput [record
  [field id TripID] [field status TripStatus] [field fare Fare] [field createdAt DateTime]]]
[type PositionOutput [record
  [field latitude Latitude] [field longitude Longitude] [field receivedAt DateTime]]]

[query MyTrips
  [input userId UserID]
  [output [list TripOutput [max 20]]]
  [http GET "/api/users/{userId}/trips"]
  [user [entity $userId]]
  [result [order [last user.trips 20] Trip.createdAt DESC]]]

[query Trip
  [input tripId TripID]
  [output TripOutput]
  [http GET "/api/trips/{tripId}"]
  [result [entity $tripId]]]

[query LiveDriver
  [input driverId DriverID]
  [output PositionOutput]
  [websocket "/ws" [source DriverPosition]]
  [driver [entity $driverId]]
  [result [live driver.positions]]]

[mutate RequestTrip
  [input riderId UserID]
  [input pickupLat Latitude]
  [input pickupLng Longitude]
  [input dropoffLat Latitude]
  [input dropoffLng Longitude]
  [input fare Fare]
  [output TripOutput]
  [http POST "/api/trips" [status 201]]
  [atomic]
  [rider [entity $riderId]]
  [trip [create Trip [record
    [id [new TripID]] [rider rider] [pickupLat $pickupLat] [pickupLng $pickupLng]
    [dropoffLat $dropoffLat] [dropoffLng $dropoffLng]
    [fare $fare] [status REQUESTED] [createdAt request.time]]]]
  [result trip]]

[mutate AcceptTrip
  [input tripId TripID]
  [input driverId DriverID]
  [output TripOutput]
  [http POST "/api/trips/{tripId}/accept"]
  [atomic]
  [trip [entity $tripId]]
  [driver [entity $driverId]]
  [assigned [set trip.driver driver]]
  [matched [set trip.status MATCHED]]
  [result trip]]
