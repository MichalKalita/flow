# Social network: profiles, posts, follows, and likes.

[type UserID [id User]]
[type PostID [id Post]]
[type CommentID [id Comment]]
[type FollowID [id Follow]]
[type LikeID [id Like]]
[type RequestID [id Request]]
[type PageSize [integer [range 1 50]]]
[type BodyLength [integer [range 1 2000]]]

[enum Role MODERATOR]
[enum PostVisibility PUBLIC FOLLOWERS]

[entity User
  [field id UserID]
  [field identitySubject String [unique]]
  [field roles [list Role [max 1]]]
  [field handle String [unique]]
  [field displayName String]
  [field bio String]
  [field posts [list Post] [inverse Post.author]]
  [field following [list Follow] [inverse Follow.follower]]
  [field followers [list Follow] [inverse Follow.followee]]]

[entity Post
  [field id PostID]
  [field author User]
  [field body String]
  [field visibility PostVisibility]
  [field createdAt DateTime]
  [field comments [list Comment] [inverse Comment.post]]
  [field likes [list Like] [inverse Like.post]]]

[entity Comment
  [field id CommentID]
  [field post Post]
  [field author User]
  [field body String]
  [field createdAt DateTime]]

[entity Follow
  [field id FollowID]
  [field follower User]
  [field followee User]
  [field createdAt DateTime]]

[entity Like
  [field id LikeID]
  [field post Post]
  [field user User]
  [field createdAt DateTime]]

[seed User [rows
  [record [id "u1"] [identitySubject "idp:u1"] [roles [list]] [handle "petra"] [displayName "Petra"] [bio "Photos and coffee"]]
  [record [id "u2"] [identitySubject "idp:u2"] [roles [list]] [handle "david"] [displayName "David"] [bio "Cycling"]]
  [record [id "u3"] [identitySubject "idp:u3"] [roles [list]] [handle "nora"] [displayName "Nora"] [bio "Books and rain"]]
  [record [id "u4"] [identitySubject "idp:u4"] [roles [list]] [handle "omar"] [displayName "Omar"] [bio "Weeknight cooking"]]
  [record [id "u5"] [identitySubject "idp:mod"] [roles [list MODERATOR]] [handle "mod"] [displayName "Moderator"] [bio "Keep it kind"]]]]
[seed Post [rows
  [record [id "p1"] [author "u1"] [body "Morning light in Malá Strana."] [visibility PUBLIC] [createdAt "2026-10-01T07:12:00Z"]]
  [record [id "p2"] [author "u2"] [body "Fifty kilometres before breakfast."] [visibility PUBLIC] [createdAt "2026-10-01T09:40:00Z"]]
  [record [id "p3"] [author "u3"] [body "Finished The Dispossessed again."] [visibility FOLLOWERS] [createdAt "2026-10-02T21:05:00Z"]]
  [record [id "p4"] [author "u4"] [body "Lentil soup with too much cumin. Still good."] [visibility PUBLIC] [createdAt "2026-10-03T18:22:00Z"]]
  [record [id "p5"] [author "u1"] [body "Closed beta of the photo dump."] [visibility FOLLOWERS] [createdAt "2026-10-04T12:00:00Z"]]]]
[seed Comment [rows
  [record [id "c1"] [post "p1"] [author "u2"] [body "That alley by the church?"] [createdAt "2026-10-01T07:30:00Z"]]
  [record [id "c2"] [post "p1"] [author "u3"] [body "Need that hour of the day."] [createdAt "2026-10-01T08:01:00Z"]]
  [record [id "c3"] [post "p2"] [author "u1"] [body "Show the route next time."] [createdAt "2026-10-01T10:11:00Z"]]
  [record [id "c4"] [post "p4"] [author "u5"] [body "Cumin can stay."] [createdAt "2026-10-03T18:40:00Z"]]
  [record [id "c5"] [post "p3"] [author "u4"] [body "Le Guin always holds up."] [createdAt "2026-10-02T21:40:00Z"]]]]
[seed Follow [rows
  [record [id "f1"] [follower "u1"] [followee "u2"] [createdAt "2026-09-12T10:00:00Z"]]
  [record [id "f2"] [follower "u2"] [followee "u1"] [createdAt "2026-09-12T10:05:00Z"]]
  [record [id "f3"] [follower "u3"] [followee "u1"] [createdAt "2026-09-20T14:00:00Z"]]
  [record [id "f4"] [follower "u4"] [followee "u3"] [createdAt "2026-09-22T08:30:00Z"]]
  [record [id "f5"] [follower "u5"] [followee "u1"] [createdAt "2026-09-25T16:00:00Z"]]]]
[seed Like [rows
  [record [id "k1"] [post "p1"] [user "u2"] [createdAt "2026-10-01T07:20:00Z"]]
  [record [id "k2"] [post "p1"] [user "u3"] [createdAt "2026-10-01T07:45:00Z"]]
  [record [id "k3"] [post "p2"] [user "u1"] [createdAt "2026-10-01T09:50:00Z"]]
  [record [id "k4"] [post "p4"] [user "u1"] [createdAt "2026-10-03T18:30:00Z"]]
  [record [id "k5"] [post "p5"] [user "u2"] [createdAt "2026-10-04T12:10:00Z"]]]]

[auth
  [user User
    [jwt [issuer "https://identity.example.com"] [audience "social"]]
    [entity [eq User.identitySubject claims.sub]]]
  [anonymous Anonymous]]
[transport HTTP [auth user anonymous]]

[permissions *
  [User [READ [when true]]]
  [Post [READ [when [eq target.visibility PUBLIC]]]]]

[permissions User
  [User [UPDATE [when [eq actor target]]]]
  [Post
    [READ [when [or
      [eq target.visibility PUBLIC]
      [eq actor target.author]
      [any target.author.followers follow [eq follow.follower actor]]]]]
    [CREATE [when [eq actor after.author]]]
    [DELETE [when [or [eq actor target.author] [contains actor.roles MODERATOR]]]]]
  [Comment
    [READ [when [can READ target.post]]]
    [CREATE [when [and [eq actor after.author] [can READ after.post]]]]]
  [Follow
    [READ [when true]]
    [CREATE [when [and [eq actor after.follower] [neq actor after.followee]]]]]
  [Like
    [READ [when [can READ target.post]]]
    [CREATE [when [and [eq actor after.user] [can READ after.post]]]]]]

[type UserSummary [record [field id UserID] [field handle String] [field displayName String]]]
[type PostOutput [record
  [field id PostID] [field author UserSummary] [field body String]
  [field visibility PostVisibility] [field createdAt DateTime]]]
[type CommentOutput [record
  [field id CommentID] [field author UserSummary] [field body String] [field createdAt DateTime]]]

[query Timeline
  [input userId UserID]
  [input pageSize PageSize]
  [output [list PostOutput [max 50]]]
  [http GET "/api/users/{userId}/timeline"]
  [user [entity $userId]]
  [result [order [last user.posts $pageSize] Post.createdAt DESC]]]

[query Post
  [input postId PostID]
  [output PostOutput]
  [http GET "/api/posts/{postId}"]
  [result [entity $postId]]]

[query PostComments
  [input postId PostID]
  [output [list CommentOutput [max 50]]]
  [http GET "/api/posts/{postId}/comments"]
  [post [entity $postId]]
  [result [order [last post.comments 50] Comment.createdAt ASC]]]

[mutate CreatePost
  [input authorId UserID]
  [input body String]
  [input visibility PostVisibility]
  [output PostOutput]
  [http POST "/api/posts" [status 201]]
  [atomic]
  [author [entity $authorId]]
  [post [create Post [record
    [id [new PostID]] [author author] [body $body]
    [visibility $visibility] [createdAt request.time]]]]
  [result post]]

[mutate FollowUser
  [input followerId UserID]
  [input followeeId UserID]
  [output Follow]
  [http POST "/api/follows" [status 201]]
  [atomic]
  [follower [entity $followerId]]
  [followee [entity $followeeId]]
  [follow [create Follow [record
    [id [new FollowID]] [follower follower] [followee followee] [createdAt request.time]]]]
  [result follow]]

[mutate LikePost
  [input userId UserID]
  [input postId PostID]
  [output Like]
  [http POST "/api/likes" [status 201]]
  [atomic]
  [user [entity $userId]]
  [post [entity $postId]]
  [like [create Like [record
    [id [new LikeID]] [user user] [post post] [createdAt request.time]]]]
  [result like]]
