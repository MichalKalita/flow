{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "[^\\s\\[\\]#\"]+",
  "indentationRules": {
    "increaseIndentPattern": "\\[[^\\]\\n]*$",
    "decreaseIndentPattern": "^\\s*\\]"
  }
}
